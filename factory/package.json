{
  "name": "selfheal-factory",
  "version": "0.1.0",
  "description": "Sentry issue triage with Jev and a self-healing fix factory",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "type-check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "pnpm run type-check && pnpm test"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  }
}
