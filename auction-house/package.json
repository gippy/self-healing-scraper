{
  "name": "auction-house",
  "version": "0.1.0",
  "description": "A fictional live auction house with switchable layouts, the target of the self-healing scrapers",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "type-check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "pnpm run type-check && pnpm test"
  },
  "engines": {
    "node": ">=24.11 <25"
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
